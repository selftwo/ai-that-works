    {
      "id": 53,
      "start": 114.399,
      "end": 115.6,
      "text": ">> Um,"
    },
    {
      "id": 54,
      "start": 115.6,
      "end": 118.07900000000001,
      "text": ">> I'm just wondering if like there are"
    },
    {
      "id": 55,
      "start": 118.07900000000001,
      "end": 121.04,
      "text": "pretty good OCR models that do bounding"
    },
    {
      "id": 56,
      "start": 121.04,
