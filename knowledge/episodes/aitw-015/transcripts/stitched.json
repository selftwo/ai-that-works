    {
      "id": 145,
      "start": 309.68,
      "end": 311.919,
      "text": "previously when we were processing"
    },
    {
      "id": 146,
      "start": 311.919,
      "end": 313.84,
      "text": "invoices. Yeah,"
    },
    {
      "id": 147,
      "start": 313.84,
      "end": 316.08,
      "text": ">> this is pre-LM days when we were all"
